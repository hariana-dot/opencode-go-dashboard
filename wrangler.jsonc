{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opencode-go-dashboard",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  // Optional: bind a custom domain after deploy
  // "routes": [
  //   {
  //     "pattern": "dashboard.example.com",
  //     "custom_domain": true
  //   }
  // ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opencode-go-dashboard",
      // Run: wrangler d1 create opencode-go-dashboard
      "database_id": "c69a7376-1343-45c1-9817-61b159187d02"
    }
  ],
  "observability": {
    "enabled": true
  }
}